# Local configuration. Copy to .env and fill in:  cp .env.example .env
#
# .env is gitignored. Never commit a real value here.

# Required. The database this instance serves.
#
# There is no default on purpose. The application used to fall back to a
# connection string committed in index.js, which meant it quietly connected to
# Atlas even when told otherwise. Set it explicitly.
MONGOLAB_URI=mongodb://127.0.0.1:27017/finadmin_db

# Required in production. The server refuses to start without it rather than
# sign tokens with a known value.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Verification only. Set this to the PREVIOUS signing secret when rotating, so
# tokens already issued keep working and nobody is signed out by the deploy.
# Leave empty otherwise, and empty it again once sessions have aged out.
JWT_LEGACY_SECRET=

# How long a newly issued token stays valid. Does not apply retroactively.
JWT_EXPIRES_IN=12h