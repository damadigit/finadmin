# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store

# Local configuration and secrets.
#
# The deploy workflow writes a .env on the runner and copies it to the server,
# and a developer needs one locally now that MONGOLAB_URI and JWT_SECRET are
# required. Neither belongs in the repository: the database password and the
# token signing secret are the two things an attacker with read access to this
# history would most want.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
/uploads